
{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/b/:file(.*\\.pdf)",
      "destination": "https://nqwgxkdpwpgqkezaqsrx.supabase.co/storage/v1/object/public/invoices/:file"
    },
    {
      "source": "/b/:path*",
      "destination": "/api/b?path=:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
